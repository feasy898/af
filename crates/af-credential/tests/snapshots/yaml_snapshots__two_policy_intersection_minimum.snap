---
source: crates/af-credential/tests/yaml_snapshots.rs
expression: snapshot
---
kind: two_policy_intersection_minimum
cedar_policies: "\npermit(principal == Role::\"reviewer\", action == Action::\"test\", resource == Line::\"line-a\");\npermit(principal == Role::\"builder\", action == Action::\"git\", resource == Line::\"line-a\");\n"
root_tools:
  - git
  - test
root_namespace: line-a
root_budget_cents: 1000
child_tools:
  - test
child_spend_cap_cents: 500
tool_intersection:
  - test
declared_spend_cap_cents: 500
attenuated_facts_tools:
  - git
  - test
attenuated_namespace: line-a
attenuated_budget_cents: 1000
probes:
  - name: reviewer_test_inside_cap
    role: reviewer
    tool: test
    namespace: line-a
    spend_cents: 100
    root:
      allow: true
      cedar_allow: true
      biscuit_allow: true
      token_carries_capability: true
      reason: "cedar=true, biscuit=true, token_carries(test @ line-a)=true, blocks=1"
    attenuated:
      allow: true
      cedar_allow: true
      biscuit_allow: true
      token_carries_capability: true
      reason: "cedar=true, biscuit=true, token_carries(test @ line-a)=true, blocks=2"
