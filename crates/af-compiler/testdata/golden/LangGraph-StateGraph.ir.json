        "share_budget_pct": 15
      },
      "runtime_rewrite": {
        "kind": "meta_loop",
        "impl_ref": "packages/langgraph@1.0.0/hatches/runtime_rewrite.py",
        "reason": "运行时自举改写图结构（临时插入/删除边、运行时决定节点集合）；AFB 拓扑必须静态声明，改图只能退化为状态驱动路由",
        "owner": "lang-team",
        "share_budget_pct": 20
      },
      "side_effects": {
        "kind": "env_adapter",
        "impl_ref": "packages/langgraph@1.0.0/hatches/side_effects.py",
        "reason": "节点内任意副作用与外部交互；AFB 不承诺节点级事务/回滚，DSL 若承诺事务性即越界",
        "owner": "lang-team",
        "share_budget_pct": 15
      },
      "stream_exec": {
        "kind": "env_adapter",
        "impl_ref": "packages/langgraph@1.0.0/hatches/stream_exec.py",
        "reason": "节点内部并发与流式/取消语义；AFB 执行模型为 super-step 级同步，节点内并发需宿主语言支持",
        "owner": "lang-team",
        "share_budget_pct": 10
      },
      "suspend_resume": {
        "kind": "runtime_context_mutation",
        "impl_ref": "packages/langgraph@1.0.0/hatches/suspend_resume.py",
        "reason": "节点内部任意位置挂起并在运行中注入外部输入续跑，过程语义与副作用不回滚无法由边界暂停表达",
        "owner": "lang-team",
        "share_budget_pct": 15
      },
